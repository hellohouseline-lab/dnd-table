{
  "name": "dnd-table",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "lint": "oxlint",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked --schema public > src/live/database.types.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "test:previews": "playwright test e2e/previews.spec.ts",
    "test:call": "playwright test e2e/call.spec.ts"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "0.0.12",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "howler": "2.2.4",
    "konva": "10.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "19.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/howler": "2.2.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
